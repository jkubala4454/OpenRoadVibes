{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORV-LF Record Schema",
  "type": "object",

  "required": [
    "timestamp",
    "latitude",
    "longitude",
    "speed",
    "accel_rms",
    "jerk",
    "vibration_energy"
  ],

  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp with milliseconds"
    },

    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },

    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },

    "speed": {
      "type": "number",
      "minimum": 0
    },

    "accel_rms": {
      "type": "number",
      "minimum": 0
    },

    "jerk": {
      "type": "number"
    },

    "vibration_energy": {
      "type": "number",
      "minimum": 0
    },

    "device_id": {
      "type": "string"
    },

    "vehicle_type": {
      "type": "string",
      "enum": ["bike", "scooter", "moped", "other"]
    },

    "imu_model": {
      "type": "string"
    },

    "firmware_version": {
      "type": "string"
    },

    "sampling_rate_hz": {
      "type": "number",
      "minimum": 1
    },

    "hdop": {
      "type": "number",
      "minimum": 0
    },

    "gps_lost": {
      "type": "boolean"
    },

    "notes": {
      "type": "string"
    },

    "session_id": {
      "type": "string"
    },

    "operator_id": {
      "type": "string"
    },

    "battery_voltage": {
      "type": "number"
    },

    "temperature_c": {
      "type": "number"
    }
  },

  "additionalProperties": false
}
